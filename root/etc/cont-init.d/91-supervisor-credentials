#!/bin/bash

# Replace the placeholder supervisor socket credentials with fresh random
# values on each start. Username and password get independent values (the
# upstream version reused one string for both).
random_user=$(tr -dc A-Za-z0-9 < /dev/urandom | head -c 20)
random_pass=$(tr -dc A-Za-z0-9 < /dev/urandom | head -c 20)
sed -i -E "s!^username = dummy!username = ${random_user}!" /etc/supervisor/supervisord.conf
sed -i -E "s!^password = dummy!password = ${random_pass}!" /etc/supervisor/supervisord.conf
