#!/bin/bash
# PUID/PGID/youtubedl_autoupdate are provided by the container environment.
# shellcheck disable=SC2154

# Running everything as root would defeat the unprivileged 'abc' user.
if [ "$PUID" = "0" ] || [ "$PGID" = "0" ]; then
  echo "[permissions] ERROR: PUID/PGID must not be 0 (that would run as root)."
  echo "[permissions] Choose a non-root UID/GID. Aborting."
  exit 1
fi

groupmod -o -g "$PGID" abc
usermod -o -u "$PUID" abc

mkdir -p /var/log/youtube-dl/
mkdir -p /var/log/youtube-dl-webui/

# Only data and logs are owned by the runtime user.
chown -R abc:abc /config
chown -R abc:abc /downloads
chown -R abc:abc /var/log

# abc's HOME (created 0700 for the build-time UID) must follow a PUID change,
# otherwise abc cannot use it for caches (yt-dlp, deno).
chown -R abc:abc /home/abc

# Application code (/app) and the virtualenv (/opt/venv) stay root-owned, in
# root-owned parent directories, and read-only to abc: a compromised
# download/web process can neither modify nor replace (rename) the web UI,
# scripts or yt-dlp. The venv only needs abc ownership when the self-updater
# writes into it.
if [ "$youtubedl_autoupdate" = true ]; then
  chown -R abc:abc /opt/venv
fi
