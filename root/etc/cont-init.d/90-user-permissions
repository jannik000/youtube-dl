#!/bin/bash
# PUID/PGID/youtubedl_autoupdate are provided by the container environment.
# shellcheck disable=SC2154

# Running everything as root would defeat the unprivileged 'abc' user.
if [ "$PUID" = "0" ] || [ "$PGID" = "0" ]; then
  echo "[permissions] ERROR: PUID/PGID must not be 0 (that would run as root)."
  echo "[permissions] Choose a non-root UID/GID. Aborting."
  exit 1
fi

groupmod -o -g "$PGID" abc
usermod -o -u "$PUID" abc

mkdir -p /var/log/youtube-dl/
mkdir -p /var/log/youtube-dl-webui/

# Only data and logs are owned by the runtime user.
chown -R abc:abc /config
chown -R abc:abc /downloads
chown -R abc:abc /var/log

# abc's home must belong to abc: it is created with mode 0700 for the build-time
# UID, so after a PUID change abc could otherwise neither enter it (and thus not
# run the venv's python/yt-dlp) nor write caches (yt-dlp, deno) there.
chown abc:abc /home/abc
find /home/abc -mindepth 1 -maxdepth 1 ! -name .venv -exec chown -R abc:abc {} +

# Application code (/app) and the virtualenv stay root-owned and read-only to
# abc, so a compromised download/web process cannot overwrite the web UI,
# scripts or yt-dlp itself. The venv only needs abc ownership when the
# self-updater writes into it.
if [ "$youtubedl_autoupdate" = true ]; then
  chown -R abc:abc /home/abc/.venv
fi
